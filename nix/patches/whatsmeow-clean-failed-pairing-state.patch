+func (cli *Client) deleteFailedPairingStore(ctx context.Context) {
+	cleanupCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)
+	defer cancel()
+	if err := cli.Store.Delete(cleanupCtx); err != nil {
+		cli.Log.Warnf("Failed to delete local store after pairing failure: %v", err)
+	}
+	cli.paired.Store(false)
